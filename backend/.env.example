# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit it.
# Production values are set via fly secrets, not this file.

# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/research_events?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret

# Optional — defaults shown
PORT=8080
ENV=development
# Must be a specific origin (not *) so HTTP-only cookies work cross-origin.
# In production set this to your Vercel frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_VERSION=dev
