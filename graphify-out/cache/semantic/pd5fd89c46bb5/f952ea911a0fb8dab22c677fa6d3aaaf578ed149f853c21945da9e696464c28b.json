{"nodes": [{"id": "ai_sessions_2026_06_15_observability_tracing_bugfix_doc", "label": "Session: OpenTelemetry Tracing \u2014 Sentry Double-Sampling Bug Fix", "file_type": "document", "source_file": "ai-sessions/2026-06-15-observability-tracing-bugfix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_15_observability_tracing_bugfix_bug", "label": "Sentry double-sampling bug: unset TracesSampleRate silently drops all transactions", "file_type": "rationale", "source_file": "ai-sessions/2026-06-15-observability-tracing-bugfix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sentry.Init was called with EnableTracing:true but TracesSampleRate defaulted to 0.0; the sentryotel span processor's fallback sampling decision then rejected every transaction independently of the OTel ParentBased sampler, stacking two independent sampling gates where the second always rejected everything. Fixed by setting TracesSampleRate:1.0 so OTel remains the single source of truth for which spans are created."}], "edges": [{"source": "ai_sessions_2026_06_15_observability_tracing_bugfix_doc", "target": "ai_sessions_2026_06_15_observability_tracing_bugfix_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-15-observability-tracing-bugfix.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_15_observability_tracing_bugfix_doc", "target": "ai_sessions_2026_06_14_observability_opentelemetry_planning_feature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-15-observability-tracing-bugfix.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_15_observability_tracing_bugfix_doc", "target": "ai_sessions_2026_06_14_observability_opentelemetry_planning_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-15-observability-tracing-bugfix.md", "source_location": null, "weight": 1.0}], "hyperedges": []}