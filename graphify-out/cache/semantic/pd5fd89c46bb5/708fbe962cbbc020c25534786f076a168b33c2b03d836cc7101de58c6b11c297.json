{"nodes": [{"id": "ai_sessions_2026_06_13_events_list_feature_doc", "label": "Session: Events List Feature (GET /api/v1/events)", "file_type": "document", "source_file": "ai-sessions/2026-06-13-events-list-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_13_events_list_feature_feature", "label": "Events List Feature (filterable, paginated, bbox, tier, first_deadline_month)", "file_type": "concept", "source_file": "ai-sessions/2026-06-13-events-list-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_13_events_list_feature_r_pagination_defaults", "label": "Pagination defaults must always be present", "file_type": "rationale", "source_file": "ai-sessions/2026-06-13-events-list-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GORM's Limit(0) returns zero rows, not 'no limit', so Page/PageSize must always be populated (1/20 default) even for pagination=off calls; PaginationOff is the actual switch that skips Limit/Offset."}, {"id": "ai_sessions_2026_06_13_events_list_feature_r_first_deadline_month_subquery", "label": "first_deadline_month via correlated EXISTS+MIN subquery", "file_type": "rationale", "source_file": "ai-sessions/2026-06-13-events-list-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtering events by their earliest active abstract/paper deadline's month and year is implemented as a single correlated subquery rather than a join, keeping the count query and select query symmetric."}, {"id": "ai_sessions_2026_06_13_events_list_feature_r_gorm_bool_default_gotcha", "label": "GORM zero-value bool + gorm:default tag gotcha", "file_type": "rationale", "source_file": "ai-sessions/2026-06-13-events-list-feature.md", "