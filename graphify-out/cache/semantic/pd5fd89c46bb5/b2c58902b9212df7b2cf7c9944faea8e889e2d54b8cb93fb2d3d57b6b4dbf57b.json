{"nodes": [{"id": "ai_sessions_2026_06_12_event_submission_feature_doc", "label": "Session: Event Submission Feature (POST /api/v1/events/submit)", "file_type": "document", "source_file": "ai-sessions/2026-06-12-event-submission-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_12_event_submission_feature_feature", "label": "Event Submission Feature (public, contributor lookup/creation, slug reuse)", "file_type": "concept", "source_file": "ai-sessions/2026-06-12-event-submission-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_12_event_submission_feature_r_slug_partial_unique_index", "label": "Partial unique index for slug reuse", "file_type": "rationale", "source_file": "ai-sessions/2026-06-12-event-submission-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "events_slug_idx is UNIQUE(slug) WHERE deleted_at IS NULL AND status IN ('pending','approved'), letting a rejected event keep its slug in the row for history while allowing a new submission to reuse that slug \u2014 enforced at the DB level, not just in application code."}, {"id": "ai_sessions_2026_06_12_event_submission_feature_r_auditlog_in_repository", "label": "AuditLog construction stays in repository, not service", "file_type": "rationale", "source_file": "ai-sessions/2026-06-12-event-submission-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service layer is pure and cannot know post-insert IDs; buildSubmissionAuditLogs is a plain, non-FP helper that lives in the repository and runs after tx.Create(&event) inside the same transaction, keeping the service free of I/O."}, {"id": "ai_sessions_2026_06_12_event_submission_feature_r_contributor_lookup_creation