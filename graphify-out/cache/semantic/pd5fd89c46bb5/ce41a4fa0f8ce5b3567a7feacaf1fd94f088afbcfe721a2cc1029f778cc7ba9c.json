{"nodes": [{"id": "ai_sessions_2026_06_09_auth_feature_doc", "label": "Session: Auth Feature (Login, Refresh Token, Logout, Account Unlock)", "file_type": "document", "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_09_auth_feature_feature", "label": "Auth Feature (login, refresh-token, logout, unlock, JWT middleware, rate limiting)", "file_type": "concept", "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_09_auth_feature_r_stateful_jwt_jti", "label": "Stateful JWT via JTI column", "file_type": "rationale", "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each access token carries a jti (UUID v4) claim; the server stores only the jti (not the full token) in users.access_token_jti. RequireAuth verifies the JWT signature locally then checks jti against the DB value for revocation, avoiding full-token storage."}, {"id": "ai_sessions_2026_06_09_auth_feature_r_refresh_token_format", "label": "Refresh token format {userID}.{randomHex}", "file_type": "rationale", "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semi-opaque format embeds the user ID to avoid a full-table hash lookup on refresh while a 64-byte random hex provides 256 bits of entropy; a deliberate deviation from a fully-opaque token, which would have made reuse detection (clearing DB tokens on reuse) impossible without knowing the user ID."}, {"id": "ai_sessions_2026_06_09_auth_feature_r_cors_credentials_origin", "label": "CORS default changed from * to http://localhost:3000", "file_type": "rationale", "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTTP-only cookies cannot be set cross-origin when Allow-Origin is '*', because browsers disallow combining a wildcard origin with Allow-Credentials: true."}, {"id": "ai_sessions_2026_06_09_auth_feature_r_rate_limiter_token_bucket", "label": "In-memory token bucket rate limiter", "file_type": "rationale", "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "golang.org/x/time/rate token bucket (10 req/min/IP) is acceptable at current scale even though counters reset on restart; a Redis-backed limiter would be needed for multi-instance deployments."}, {"id": "ai_sessions_2026_06_09_auth_feature_account_lockout", "label": "Account lockout after 5 failed login attempts", "file_type": "concept", "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "ai_sessions_2026_06_09_auth_feature_feature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "ai_sessions_2026_06_09_auth_feature_r_stateful_jwt_jti", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "ai_sessions_2026_06_09_auth_feature_r_refresh_token_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "ai_sessions_2026_06_09_auth_feature_r_cors_credentials_origin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "ai_sessions_2026_06_09_auth_feature_r_rate_limiter_token_bucket", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "ai_sessions_2026_06_09_auth_feature_account_lockout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "claude_architecture_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "docker_compose_postgres_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_09_auth_feature_doc", "target": "ai_sessions_2026_06_12_event_submission_feature_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-09-auth-feature.md", "source_location": null, "weight": 1.0}], "hyperedges": []}