{"nodes": [{"id": "ai_sessions_2026_06_15_frontend_api_client_error_handling_feature_doc", "label": "Session: API Client + Error Handling (Frontend)", "file_type": "document", "source_file": "ai-sessions/2026-06-15-frontend-api-client-error-handling-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_15_frontend_api_client_error_handling_feature_feature", "label": "API Client + Error Handling feature (typed fetch client, error-to-toast mapping)", "file_type": "concept", "source_file": "ai-sessions/2026-06-15-frontend-api-client-error-handling-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_15_frontend_api_client_error_handling_feature_r_shadcn_manual_setup", "label": "shadcn/ui manual setup instead of CLI", "file_type": "rationale", "source_file": "ai-sessions/2026-06-15-frontend-api-client-error-handling-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither shadcn CLI version (2.3.0, 4.11) worked: v4.11's new preset registry 404s and doesn't map to 'Neutral', v2.3.0 doesn't support Tailwind v4's CSS-first config, so the equivalent setup was built by hand following shadcn's documented Tailwind v4 conventions."}, {"id": "ai_sessions_2026_06_15_frontend_api_client_error_handling_feature_r_hand_written_api_types", "label": "Hand-written src/types/api.ts as temporary exception", "file_type": "rationale", "source_file": "ai-sessions/2026-06-15-frontend-api-client-error-handling-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLAUDE.md bans hand-writing API types in favor of OpenAPI-generated types, but no OpenAPI spec exists yet, so types were transcribed from the backend YAML specs as a deliberate, temporary exception."}