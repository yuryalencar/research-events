{"nodes": [{"id": "claude_doc", "label": "CLAUDE.md \u2014 ReSEARCH Events Project Instructions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_fp_pure_function", "label": "FP: Pure Function principle", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function is pure if, given the same inputs, it always returns the same output and has no side effects (no mutation of external state, no I/O, no globals). Pure functions are trivially testable \u2014 no mocks needed, just input to output."}, {"id": "claude_fp_immutability", "label": "FP: Immutability principle", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never mutate a struct passed as a parameter; always return a new copy with the changes applied. This prevents a whole class of bugs where shared state is modified unexpectedly across function boundaries."}, {"id": "claude_fp_no_side_effects", "label": "FP: No Side Effects / separation of computation from I/O", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Side effects (DB writes, HTTP calls, logging) belong in the handler or repository layer, never inside a service function that computes a result. Separating computation from I/O makes each piece independently testable."}, {"id": "claude_pair_programming_workflow", "label": "Pair Programming Workflow (Phase 0\u20136)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_tdd_red_green_refactor", "label": "Strict Red-Green-Refactor TDD", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_release_protocol", "label": "Release Protocol / Semantic Versioning", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_spec_driven_development", "label": "Spec-Driven Development", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_architecture_rules", "label": "Architecture Rules (immutable deadlines, mandatory AuditLog, JWT cookie-only)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_doc", "target": "claude_fp_pure_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "claude_fp_immutability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "claude_fp_no_side_effects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "claude_pair_programming_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "claude_tdd_red_green_refactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weig