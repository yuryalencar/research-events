{"nodes": [{"id": "ai_sessions_2026_06_14_event_deadlines_add_feature_doc", "label": "Session: Add Deadlines to an Approved Event (POST /api/v1/events/{id}/deadlines)", "file_type": "document", "source_file": "ai-sessions/2026-06-14-event-deadlines-add-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_14_event_deadlines_add_feature_feature", "label": "Add Deadlines to an Approved Event feature (collaborative keep-deadlines-fresh)", "file_type": "concept", "source_file": "ai-sessions/2026-06-14-event-deadlines-add-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_14_event_deadlines_add_feature_r_audit_row_per_logical_change", "label": "One audit row per logical change, not per row written", "file_type": "rationale", "source_file": "ai-sessions/2026-06-14-event-deadlines-add-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding N deadlines writes exactly 2 audit rows total: one deadline_added/batch_deadlines_added row and one always-written updated row for the last_updated_by_id change, establishing the pattern for all future event-update endpoints."}, {"id": "ai_sessions_2026_06_14_event_deadlines_add_feature_r_no_automatic_supersession", "label": "No automatic supersession (documented limitation)", "file_type": "rationale", "source_file": "ai-sessions/2026-06-14-event-deadlines-add-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no reliable signal to distinguish an update to an existing deadline from a genuinely new deadline with a similar description, so duplicate deadlines are accepted as new active rows until a dedicated supersession endpoint exists."}], "edges": [{"source": "ai_sessions_2026_06_14_event_d