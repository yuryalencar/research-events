{"nodes": [{"id": "ai_sessions_2026_06_14_admin_events_review_feature_doc", "label": "Session: Admin/Moderator Event Review (PATCH /api/v1/admin/events/{id}/review)", "file_type": "document", "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_14_admin_events_review_feature_feature", "label": "Admin/Moderator Event Review feature (approve/reject, partial edit, reviewer reason)", "file_type": "concept", "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ai_sessions_2026_06_14_admin_events_review_feature_r_omit_associations_gorm", "label": "GORM Omit(clause.Associations) fix", "file_type": "rationale", "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain tx.Save() on an event that still carries stale CreatedBy/LastUpdatedBy associations from an earlier reload overwrites the explicitly-set LastUpdatedByID foreign key; Omit(clause.Associations) stops GORM from re-saving those associations."}, {"id": "ai_sessions_2026_06_14_admin_events_review_feature_r_shared_parsedatefield", "label": "Shared parseDateField helper", "file_type": "rationale", "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submit and Review handlers both needed identical YYYY-MM-DD parsing and error messages; extracting parseDateField gives one place to change the date format and guarantees identical error text across endpoints."}, {"id": "ai_sessions_2026_06_14_admin_events_review_feature_r_reuse_validate_edited_event", "label": "Reusing ValidateEditedEvent for partial updates", "file_type": "rationale", "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging optional review edits onto the existing event and validating with the exact same per-field checks as submission guarantees a reviewer's edit can never produce an event that wouldn't have passed original submission validation."}], "edges": [{"source": "ai_sessions_2026_06_14_admin_events_review_feature_doc", "target": "ai_sessions_2026_06_14_admin_events_review_feature_feature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_14_admin_events_review_feature_doc", "target": "ai_sessions_2026_06_14_admin_events_review_feature_r_omit_associations_gorm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_14_admin_events_review_feature_doc", "target": "ai_sessions_2026_06_14_admin_events_review_feature_r_shared_parsedatefield", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_14_admin_events_review_feature_doc", "target": "ai_sessions_2026_06_14_admin_events_review_feature_r_reuse_validate_edited_event", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ai-sessions/2026-06-14-admin-events-review-feature.md", "source_location": null, "weight": 1.0}, {"source": "ai_sessions_2026_06_14_admin_events_review_feature_doc", "target": "claude_fp_immutability", "relation": "